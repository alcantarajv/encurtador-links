# Modelo de configuracao para o docker-compose.yml.
#
# Copie para .env e ajuste:   cp .env.example .env
#
# O compose le o arquivo .env da raiz do projeto automaticamente. O .env esta no
# .gitignore; este .env.example esta versionado justamente para documentar quais
# variaveis existem, sem que nenhum valor real entre no repositorio.
#
# Todas tem default no docker-compose.yml -- o projeto sobe sem criar o .env.
# Estes defaults servem so para desenvolvimento local.

# --- Banco de dados --------------------------------------------------------
POSTGRES_DB=encurtador
POSTGRES_USER=encurtador
POSTGRES_PASSWORD=encurtador

# --- Aplicacao -------------------------------------------------------------

# Porta publicada no host. Util se a 8080 ja estiver ocupada.
APP_PORT=8080

# Endereco publico usado para montar a URL curta na resposta da API. Atras de um
# proxy, o host que chega na requisicao nao e o host que o usuario digitou.
SHORTENER_BASE_URL=http://localhost:8080

# Sal do hash do IP no registro de cliques. O IP nunca e gravado: o que vai ao
# banco e o SHA-256 do sal + IP.
#
# Precisa ser secreto. O espaco de IPv4 tem 4 bilhoes de enderecos -- se o sal
# vazar, da para calcular o hash de todos eles e descobrir quem visitou o que.
# Precisa tambem ser estavel: trocar o sal faz os hashes antigos deixarem de
# casar com os novos, e a contagem de visitantes distintos reinicia.
#
# Gere um valor proprio, por exemplo:
#   openssl rand -base64 32
CLICK_IP_SALT=troque-este-valor

# --- Variaveis que so aparecem em producao ---------------------------------
#
# Nao precisam ser preenchidas aqui: localmente todas tem default. Ficam
# documentadas porque sao elas que o render.yaml define no deploy.
#
#   PORT                    porta escolhida pela plataforma; a aplicacao le e
#                           escuta nela (default 8080)
#   SPRING_PROFILES_ACTIVE  "prod" no deploy -- liga as verificacoes de
#                           ProductionSafetyCheck e, pelo grupo de perfis, o
#                           perfil "docker" junto
#   REDIS_URL               URL unica do Redis gerenciado, com senha e TLS
#                           quando houver; tem precedencia sobre REDIS_HOST e
#                           REDIS_PORT
#   DB_POOL_SIZE            teto de conexoes do HikariCP (default 10)
#   DB_CONNECTION_TIMEOUT   espera por conexao livre, em ms (default 3000).
#                           Bancos gratuitos que hibernam precisam de mais
